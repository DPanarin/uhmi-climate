{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true
  },
  "ignorePatterns": ["data-raw/**"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  }
}
