{
  "name": "uhmi-climate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:prettier": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{ts,mjs,js}\"",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{ts,mjs,js}\"",
    "data:extract": "node -e \"console.error('data:extract is implemented in P1');process.exit(1)\"",
    "data:build": "node -e \"console.error('data:build is implemented in P2');process.exit(1)\"",
    "deploy": "npm run build && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "lucide-vue-next": "^1.0.0",
    "maplibre-gl": "^6.12.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "acorn": "^8.19.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "gh-pages": "^6.3.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "mapshaper": "^0.7.78",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
